---
import type { Player } from "../types";
import { withBase } from "../lib/url";
import PlayerAvatar from "./PlayerAvatar.astro";

interface Props {
  /** Uppercase card title, e.g. "Biggest climber". */
  label: string;
  /** Command-style sub-label shown with a `$` prompt, e.g. "climber --week". */
  command: string;
  /** Decorative glyph rendered aria-hidden (e.g. a medal or arrow). */
  icon?: string;
  /** Large headline value, e.g. "10 pts" or "▲ 4". Omit for text-only cards. */
  value?: string;
  /** Honoured player — rendered as an avatar + link when present. */
  player?: Player;
  /** Short supporting line beneath the value / player. */
  detail?: string;
  /** Longer body paragraph (e.g. the week's funniest moment). */
  text?: string;
  accent?: "acid" | "magenta" | "amber" | "cyan";
  class?: string;
}

const {
  label,
  command,
  icon,
  value,
  player,
  detail,
  text,
  accent = "acid",
  class: className = "",
} = Astro.props;

const accentText: Record<NonNullable<Props["accent"]>, string> = {
  acid: "text-acid",
  magenta: "text-magenta",
  amber: "text-amber",
  cyan: "text-cyan",
};
const accentBorder: Record<NonNullable<Props["accent"]>, string> = {
  acid: "hover:border-acid/50",
  magenta: "hover:border-magenta/50",
  amber: "hover:border-amber/50",
  cyan: "hover:border-cyan/50",
};
---

<article
  class:list={[
    "flex h-full flex-col rounded-lg border border-grid bg-term-panel p-4 transition-colors sm:p-5",
    accentBorder[accent],
    className,
  ]}
>
  <p class="text-[11px] text-ink-faint">
    <span class="text-acid">$</span>{" "}
    {command}
  </p>
  <h3
    class:list={[
      "mt-2 flex items-center gap-2 text-sm font-extrabold tracking-wide uppercase",
      accentText[accent],
    ]}
  >
    {icon && <span aria-hidden="true">{icon}</span>}
    {label}
  </h3>

  {
    value && (
      <p
        class:list={[
          "mt-3 text-2xl font-extrabold tabular-nums sm:text-3xl",
          accentText[accent],
        ]}
      >
        {value}
      </p>
    )
  }

  {
    player ? (
      <a
        href={withBase(`/players/${player.id}`)}
        class="group mt-3 flex items-center gap-2.5"
      >
        <PlayerAvatar player={player} class="h-9 w-9 rounded" />
        <span class="min-w-0">
          <span class="block truncate font-semibold text-ink group-hover:text-acid">
            {player.name}
          </span>
          {detail && (
            <span class="block truncate text-[11px] text-ink-faint">
              {detail}
            </span>
          )}
        </span>
      </a>
    ) : (
      detail && <p class="mt-3 text-[11px] text-ink-faint">{detail}</p>
    )
  }

  {text && <p class="mt-3 text-sm leading-relaxed text-ink-dim">{text}</p>}
</article>
