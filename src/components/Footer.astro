---
// Footer styled as a terminal status/exit line.
import { withBase } from "../lib/url";

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-grid bg-term-bg/80">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6 text-xs text-ink-faint sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p class="flex items-center gap-2">
      <span class="text-acid">$</span>
      <span>echo "EAYL Taskmaster &mdash; The Ultimate Academy Challenge"</span>
    </p>
    <p class="flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-dot-green"></span>
      <span
        >system nominal (for now) &middot; <a
          href={withBase("/about")}
          class="text-ink-faint underline-offset-2 transition-colors hover:text-acid hover:underline"
          >A Callum Mohan Production</a
        > &middot; &copy; {year}</span
      >
    </p>
  </div>
</footer>
