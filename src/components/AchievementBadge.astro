---
import type { Achievement } from "../types";

interface Props {
  achievement: Achievement;
  class?: string;
}

const { achievement, class: className = "" } = Astro.props;

// Accent → border/text token classes (kept as a typed map rather than
// conditionals in markup, matching TaskStatusBadge's pattern).
const accentClass: Record<Achievement["accent"], string> = {
  acid: "border-acid-dim bg-acid/5 text-acid",
  magenta: "border-magenta/40 bg-magenta/5 text-magenta",
  cyan: "border-cyan/40 bg-cyan/5 text-cyan",
  amber: "border-amber/40 bg-amber/5 text-amber",
};
---

<span
  class:list={[
    "inline-flex items-center gap-2 rounded-md border px-2.5 py-1.5",
    accentClass[achievement.accent],
    className,
  ]}
  title={achievement.detail}
>
  <span class="text-base leading-none" aria-hidden="true">
    {achievement.icon}
  </span>
  <span class="flex flex-col leading-tight">
    <span class="text-[11px] font-bold tracking-wide">
      {achievement.label}
    </span>
    <span class="text-[10px] text-ink-faint">{achievement.detail}</span>
  </span>
</span>
