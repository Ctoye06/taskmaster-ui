---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette.astro";
import WhatsNewBanner from "../components/WhatsNewBanner.astro";
import { getCommandPaletteItems, getWhatsNew } from "../data/queries";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "EAYL TASKMASTER // Engineering Academy Challenge",
  description = "16 weeks. 25 players. One winner. The Engineering Academy Taskmaster challenge.",
} = Astro.props;

const paletteItems = getCommandPaletteItems();
const whatsNew = getWhatsNew();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="icon" href={withBase("/favicon.ico")} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080b10" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[70] focus:bg-acid focus:text-term-bg focus:px-3 focus:py-1 focus:font-bold"
      >Skip to content</a
    >
    <Navbar />
    <WhatsNewBanner info={whatsNew} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CommandPalette items={paletteItems} />
  </body>
</html>
